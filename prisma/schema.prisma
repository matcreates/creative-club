generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  checkedItems String   @default("{}") // JSON: { [day]: boolean[] }
  completedDays String  @default("[]") // JSON: number[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
